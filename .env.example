# Copy this file to .env.dev (or .env.<environment>) and fill in real
# values. Never commit .env.dev or any other non-.example env file.

# Random 32+ byte secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# AWS region for DynamoDB. Any value works for DynamoDB Local.
AWS_REGION=us-east-1

# Point at DynamoDB Local for development. Remove/unset this to talk to
# real AWS DynamoDB instead (requires AWS credentials to be configured,
# e.g. via `aws configure` or the usual AWS_ACCESS_KEY_ID/SECRET env vars).
DYNAMODB_ENDPOINT=http://localhost:8000

# DynamoDB table name.
DYNAMODB_TABLE=calore1-app

# HTTP port for the app server.
PORT=4173
